import tkinter as tk
from tkinter import simpledialog, messagebox
import json
import os
import random
from datetime import datetime

# -----------------------------
# Local storage
# -----------------------------
DATA_FILE = "app_data.json"

def load_data():
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, "r") as f:
            return json.load(f)
    return {"subscription":"free","usage":0,"system_prompt":"","theme":"dark","temperature":0.7}

def save_data(data):
    with open(DATA_FILE, "w") as f:
        json.dump(data,f)

data = load_data()

# -----------------------------
# Free tier settings
# -----------------------------
FREE_DAILY_LIMIT = 50

# -----------------------------
# Simulated GPT responses
# -----------------------------
def generate_reply(user_msg):
    base_responses = [
        f"I see you said: '{user_msg}'. Interesting!",
        f"Let me think about: '{user_msg}'...",
        f"Here's a response to '{user_msg}': Hmm...",
        f"Analyzing: '{user_msg}'... Got it!",
        f"Responding to '{user_msg}' with my best guess..."
    ]
    if data["subscription"]=="free":
        reply = random.choice(base_responses)+"\n💡 Upgrade to Plus for instant answers!"
    elif data["subscription"]=="plus":
        reply = random.choice(base_responses).replace("Hmm","Here you go!")
    else:
        prompt = data["system_prompt"] if data["system_prompt"] else ""
        reply = random.choice(base_responses)
        if prompt: reply = f"[{prompt}] {reply}"
        temp = data.get("temperature",0.7)
        if random.random()<temp:
            reply = reply.upper()
    return reply

# -----------------------------
# Unlock codes
# -----------------------------
UNLOCK_CODES = {"plus":"PLUS123","premium":"PREMIUM123"}

# -----------------------------
# GUI Setup
# -----------------------------
root = tk.Tk()
root.title("ChatGPT Desktop")
root.geometry("950x700")
root.configure(bg="#1e1e1e")

# Sidebar
sidebar = tk.Frame(root,bg="#2e2e2e",width=220)
sidebar.pack(side=tk.LEFT,fill=tk.Y)

# Chat frame
chat_frame = tk.Frame(root,bg="#1e1e1e")
chat_frame.pack(side=tk.LEFT,fill=tk.BOTH,expand=True)

banner = tk.Label(chat_frame,text="",bg="gold",fg="black")
banner.pack(fill=tk.X)

canvas = tk.Canvas(chat_frame,bg="#1e1e1e")
scrollbar = tk.Scrollbar(chat_frame,orient="vertical",command=canvas.yview)
scrollable_frame = tk.Frame(canvas,bg="#1e1e1e")

scrollable_frame.bind(
    "<Configure>",
    lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
)

canvas.create_window((0,0),window=scrollable_frame,anchor="nw")
canvas.configure(yscrollcommand=scrollbar.set)
canvas.pack(side=tk.LEFT,fill=tk.BOTH,expand=True)
scrollbar.pack(side=tk.RIGHT,fill=tk.Y)

# Input frame
entry_frame = tk.Frame(chat_frame,bg="#1e1e1e")
entry_frame.pack(fill=tk.X,padx=10,pady=5)

entry = tk.Entry(entry_frame,bg="#3e3e3e",fg="#ffffff",insertbackground="#ffffff")
entry.pack(side=tk.LEFT,fill=tk.X,expand=True,padx=(0,5))
send_btn = tk.Button(entry_frame,text="Send",bg="#555555",fg="#ffffff")
send_btn.pack(side=tk.LEFT)

# -----------------------------
# Sidebar controls
# -----------------------------
sub_label = tk.Label(sidebar,text=f"Subscription: {data['subscription'].capitalize()}",bg="#2e2e2e",fg="white")
sub_label.pack(pady=10)

upgrade_btn = tk.Button(sidebar,text="Upgrade / Pay",bg="#555555",fg="white")
upgrade_btn.pack(pady=5,fill=tk.X,padx=5)

unlock_btn = tk.Button(sidebar,text="Enter Unlock Code",bg="#555555",fg="white")
unlock_btn.pack(pady=5,fill=tk.X,padx=5)

reset_btn = tk.Button(sidebar,text="Reset Conversation",bg="#555555",fg="white")
reset_btn.pack(pady=5,fill=tk.X,padx=5)

theme_btn = tk.Button(sidebar,text="Toggle Theme",bg="#555555",fg="white")
theme_btn.pack(pady=5,fill=tk.X,padx=5)

temp_label = tk.Label(sidebar,text="Temperature",bg="#2e2e2e",fg="white")
temp_slider = tk.Scale(sidebar,from_=0.0,to=1.0,resolution=0.05,orient=tk.HORIZONTAL,bg="#2e2e2e",fg="white",
                       highlightbackground="#2e2e2e",troughcolor="#555555")
temp_slider.set(data.get("temperature",0.7))

sys_label = tk.Label(sidebar,text="System Prompt",bg="#2e2e2e",fg="white")
sys_btn = tk.Button(sidebar,text="Edit Prompt",bg="#555555",fg="white")

if data["subscription"]=="premium":
    temp_label.pack(pady=(20,0),padx=5)
    temp_slider.pack(pady=5,padx=5)
    sys_label.pack(pady=(10,0),padx=5)
    sys_btn.pack(pady=5,padx=5)

# -----------------------------
# Functions
# -----------------------------
def add_chat(role,text):
    frame = tk.Frame(scrollable_frame,bg="#1e1e1e")
    ts = datetime.now().strftime("%H:%M")
    if role=="user":
        label = tk.Label(frame,text=f"{text}  ({ts})",bg="#4da6ff",fg="white",wraplength=600,justify="left",padx=10,pady=5)
        label.pack(anchor="e",pady=2,padx=5)
    else:
        label = tk.Label(frame,text=f"{text}  ({ts})",bg="#00ff99",fg="black",wraplength=600,justify="left",padx=10,pady=5)
        label.pack(anchor="w",pady=2,padx=5)
    frame.pack(fill=tk.BOTH,expand=True)
    canvas.update()
    canvas.yview_moveto(1.0)

def update_banner():
    if data["subscription"]=="free":
        banner.config(text="💡 Free users: Only 50 messages/day. Upgrade to Plus!")
    else:
        banner.config(text="")

def send_message(event=None):
    msg = entry.get().strip()
    if not msg: return
    entry.delete(0,tk.END)
    add_chat("user",msg)
    
    if data["subscription"]=="free":
        if data["usage"]>=FREE_DAILY_LIMIT:
            messagebox.showerror("Limit reached","🚫 Free daily limit reached. Upgrade to Plus!")
            return
        data["usage"] += 1
        
        # Random annoying popups
        if random.random() < 0.15:
            messagebox.showwarning("Oops!","Something went wrong. Try again!")
        
        add_chat("bot","GPT-5 is thinking...")
        delay = random.randint(4000,6000)  # 4-6 sec delay
        root.after(delay, lambda: display_reply(msg))
        
    else:
        display_reply(msg)
    save_data(data)

def display_reply(msg):
    reply = generate_reply(msg)
    add_chat("bot",reply)

def toggle_theme():
    if data["theme"]=="dark":
        data["theme"]="light"
        root.configure(bg="#ffffff")
        canvas.configure(bg="#f0f0f0")
        scrollable_frame.configure(bg="#f0f0f0")
        sidebar.configure(bg="#cccccc")
    else:
        data["theme"]="dark"
        root.configure(bg="#1e1e1e")
        canvas.configure(bg="#1e1e1e")
        scrollable_frame.configure(bg="#1e1e1e")
        sidebar.configure(bg="#2e2e2e")
    save_data(data)

def upgrade_action():
    messagebox.showinfo("Upgrade","Open your browser to upgrade site!")
    import webbrowser
    webbrowser.open("https://your-website.com")

def enter_code():
    code = simpledialog.askstring("Unlock Code","Enter your unlock code:")
    if not code: return
    if code==UNLOCK_CODES["plus"]:
        data["subscription"]="plus"
        sub_label.config(text="Subscription: Plus")
        messagebox.showinfo("Unlocked","Plus tier unlocked!")
    elif code==UNLOCK_CODES["premium"]:
        data["subscription"]="premium"
        sub_label.config(text="Subscription: Premium")
        messagebox.showinfo("Unlocked","Premium tier unlocked!")
        temp_label.pack(pady=(20,0),padx=5)
        temp_slider.pack(pady=5,padx=5)
        sys_label.pack(pady=(10,0),padx=5)
        sys_btn.pack(pady=5,padx=5)
    else:
        messagebox.showerror("Invalid","Invalid code!")
    save_data(data)
    update_banner()

def reset_convo():
    for widget in scrollable_frame.winfo_children():
        widget.destroy()
    if data["subscription"]=="free":
        data["usage"]=0
    save_data(data)

def edit_prompt():
    prompt = simpledialog.askstring("System Prompt","Enter system instructions:")
    if prompt is not None:
        data["system_prompt"]=prompt
        save_data(data)
        messagebox.showinfo("Saved","System prompt updated!")

def set_temperature(val):
    data["temperature"]=float(val)
    save_data(data)

# -----------------------------
# Bindings
# -----------------------------
send_btn.config(command=send_message)
entry.bind("<Return>",send_message)
theme_btn.config(command=toggle_theme)
upgrade_btn.config(command=upgrade_action)
unlock_btn.config(command=enter_code)
reset_btn.config(command=reset_convo)
sys_btn.config(command=edit_prompt)
temp_slider.config(command=set_temperature)

update_banner()
root.mainloop()
