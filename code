DATA_FILE = "app_data.json"
def load_data():
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE,"r") as f:
            return json.load(f)
    return {"subscription":"free","usage":0,"system_prompt":"","temperature":0.7}
def save_data(data):
    with open(DATA_FILE,"w") as f:
        json.dump(data,f)
data = load_data()
FREE_DAILY_LIMIT = 50

# -----------------------------
# Ask API key
# -----------------------------
app = QtWidgets.QApplication(sys.argv)
api_key, ok = QtWidgets.QInputDialog.getText(None,"API Key","Enter your OpenAI API Key:")
if not ok or not api_key:
    sys.exit("API key required.")
client = OpenAI(api_key=api_key)

# -----------------------------
# GPT reply
# -----------------------------
def gpt_reply(user_msg):
    messages = [{"role":"user","content":user_msg}]
    if data["system_prompt"]:
        messages.insert(0,{"role":"system","content":data["system_prompt"]})
    model = "gpt-5" if data["subscription"]=="free" else "gpt-5-pro"
    response = client.chat.completions.create(model=model,messages=messages,temperature=data.get("temperature",0.7))
    return response.choices[0].message.content

